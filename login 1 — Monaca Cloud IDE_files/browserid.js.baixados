async function getBrowserId() {
  const fp = await FingerprintJS.load();
  const result = await fp.get();
  const propertiesToRemove = ['screenFrame', 'colorDepth', 'screenResolution', 'plugins', 'colorGamut', 'hdr', 'canvas'];
  const components = Object.fromEntries(Object.entries(result.components).filter(([key]) => !propertiesToRemove.includes(key)));
  
  return FingerprintJS.hashComponents(components);
}
